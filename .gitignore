# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv-cache/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# pytest 在写缓存失败时会留下这些临时目录，别提交进来
pytest-cache-files-*/
pytest-of-*/
.coverage
htmlcov/

# ---- 运行产物（不要入库）----
logs/**
!logs/.gitkeep
screenshots/
artifacts/
*.log

# ---- 调试截图 ----
debug/**
!debug/.gitkeep

# ---- 业务层的生成物 ----
# 沙盒测试游戏的模板是用代码合成出来的（见 games/testgame/scene.py），
# 属于产物不是素材 —— 跑 `python -m games setup testgame` 重新生成。
games/testgame/templates/
# 名将杀的"参考画面"（自检用它验证认得准不准）和候选模板，都是本地生成物
games/mingjiangsha/fixtures/
games/mingjiangsha/_candidates/

# ---- IDE ----
.idea/
.vscode/

# ---- 系统 ----
Thumbs.db
desktop.ini
