# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv-cache/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# pytest 在写缓存失败时会留下这些临时目录，别提交进来
pytest-cache-files-*/
pytest-of-*/
.coverage
htmlcov/

# ---- 运行产物（不要入库）----
logs/**
!logs/.gitkeep
screenshots/
artifacts/
*.log

# ---- 临时目录（不要入库）----
# 测试/调试脚本喜欢用 ``tempfile.mkdtemp(dir=".")`` 在工作区里造临时目录，
# 跑完忘了删就会攒一地（这个仓库曾经攒到 140 多个，还误提交进去过三个文件）。
# 统一在这里挡掉，比每次靠人记得清理可靠。
tmp*/
tmp*

# ---- 调试截图 ----
debug/**
!debug/.gitkeep

# ---- 业务层的生成物 ----
# 名将杀的"参考画面"（自检用它验证认得准不准）和候选模板，都是本地生成物
games/mingjiangsha/fixtures/
games/mingjiangsha/_candidates/
# 名将杀的资产图（真机截图，14MB）—— 本地参考素材，自检在没有它们时会跳过那几项。
# 模板（真正要在运行期用的那张小图）是入库的。
games/mingjiangsha/jingji/assets/

# ---- IDE ----
.idea/
.vscode/

# ---- 系统 ----
Thumbs.db
desktop.ini

# 提交信息临时文件（用 git commit -F 时容易忘了删）
.git-msg*
# PyInstaller 打包产物（可重新生成：uv run python packaging/build_exe.py）
/build/
/dist/
/gamebot.exe
/packaging/*.spec
